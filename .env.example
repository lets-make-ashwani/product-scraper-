# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# MongoDB Configuration (e.g. MongoDB Atlas connection string or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=product_scraper_db

# Telegram Session Configuration (Telethon StringSession for Render 24/7 deployment)
# Get API_ID and API_HASH from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION_STRING=your_telethon_string_session_here

# Target Channel / Group Username or Numeric Chat ID (e.g. @your_channel or -100123456789)
TELEGRAM_CHAT_ID=@your_channel_or_chat_id
TELEGRAM_ENABLED=True

# Optional Bot Token fallback (if not using StringSession)
TELEGRAM_BOT_TOKEN=

# Worker & Scraper Settings
REQUEST_DELAY_SECONDS=2.0
MAX_IMAGES_PER_PRODUCT=10
AUTO_PUBLISH=True
HEADLESS_BROWSER=True

# Ephemeral Staging Directory for Temp Images (Auto-deleted after Telegram posting)
TEMP_DIR=/tmp/product_scraper_staging
